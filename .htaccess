PassengerAppRoot "/home/sawalne1/beta.sawalnepal.com"
PassengerBaseURI "/"
PassengerNodejs "/home/sawalne1/nodevenv/beta.sawalnepal.com/20/bin/node"
PassengerAppType node
PassengerStartupFile app.js
